config_version=5

[application]
config/name="FABLE STRIKE 2"
config/description="Тактический шутер 5 на 5. Сделан Fable 5.2 за сутки."
run/main_scene="res://game/boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.04, 0.045, 0.055, 1)
boot_splash/show_image=false

[autoload]
G="*res://game/main.gd"
Sfx="*res://game/sfx.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="items"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=64

[rendering]
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.055, 1)
